# --- required -------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-long-random
# >= 32 random characters, e.g.: openssl rand -hex 32
SECRET_KEY=
ADMIN_USERNAME=admin
# >= 12 characters
ADMIN_PASSWORD=
# Public host name of the dashboard. Caddy gets a Let's Encrypt certificate for it.
# Use "localhost" for a local test (self-signed certificate from Caddy's internal CA).
# An e-mail for certificate notices is optional: install.sh --email writes deploy/caddy.d/acme.caddy.
SITE_ADDRESS=jobs.example.org

# --- outbound identification -------------------------------------------------------
# Sent to Overpass and to every company website. Put a URL or e-mail where site owners can reach you.
CRAWLER_USER_AGENT=GermanyCareerCrawler/0.1 (+https://jobs.example.org/about)

# --- OpenStreetMap Overpass (be conservative: shared community service) ---------
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_STATUS_URL=https://overpass-api.de/api/status
OVERPASS_MAX_REQUESTS_PER_DAY=50
OVERPASS_MAX_MB_PER_DAY=200
OVERPASS_MIN_INTERVAL_S=30
OVERPASS_CACHE_HOURS=24
OVERPASS_QUERY_TIMEOUT_S=180

# --- website verification ------------------------------------------------------
VERIFY_CONCURRENCY=8
VERIFY_TIMEOUT_S=15
VERIFY_RECHECK_DAYS=30
# Queue newly verified companies for career-page crawling automatically
AUTO_QUEUE_VERIFIED=true

# --- misc ----------------------------------------------------------------------------
IMPORT_MAX_MB=20
LOG_LEVEL=INFO
SESSION_TTL_HOURS=12
COOKIE_SECURE=true
