# --- required -------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-long-random
# >= 32 random characters, e.g.: openssl rand -hex 32
SECRET_KEY=
ADMIN_USERNAME=admin
# >= 12 characters
ADMIN_PASSWORD=
# Public host name of the dashboard. Caddy gets a Let's Encrypt certificate for it.
# Use "localhost" for a local test (self-signed certificate from Caddy's internal CA).
# An e-mail for certificate notices is optional: install.sh --email writes deploy/caddy.d/acme.caddy.
SITE_ADDRESS=jobs.example.org

# --- outbound identification -------------------------------------------------------
# The ONE identity of every outgoing request (Overpass, website checks, robots.txt, career pages,
# ATS feeds, the browser). The robots.txt product token is derived from it: "GermanyCareerCrawler".
# Point it at the public information page of this installation: https://<SITE_ADDRESS>/bot
# (compose reads .env literally: no quotes needed, but a " #" would start a comment.)
CRAWLER_USER_AGENT=GermanyCareerCrawler/0.1 (+https://crawdler.duckdns.org/bot)
# Shown on /bot for website owners (exclusion / crawl-rate requests). Use a real mailbox you read.
# Empty: an address inside CRAWLER_USER_AGENT is used, otherwise the page says none is published.
BOT_CONTACT_EMAIL=

# --- bot API (/api/bot/v1, read-only, for the Telegram bot and other machine clients) ------
# Separate from the administrator login. Empty = the bot API answers 503 (disabled).
# One entry per client:  name:<token>   or, better, only the digest:  name:sha256:<hex>
# Create a key (prints the token ONCE and the line to paste here):
#   docker compose exec api python -m gcc_core.botauth generate telegram
# Rotation: add the new entry next to the old one, switch the client, remove the old entry,
# `docker compose up -d`. Commas or new lines separate entries. A file works too (BOT_API_KEYS_FILE).
BOT_API_KEYS=
BOT_API_KEYS_FILE=
# Requests per minute per key, failed attempts per minute per client address
BOT_RATE_LIMIT_PER_MIN=120
BOT_AUTH_FAIL_LIMIT_PER_MIN=20
BOT_MAX_PAGE_SIZE=100
BOT_MAX_CHANGES_PAGE=500
# Optional ranking weights for sort=relevance (JSON; defaults: specialization 25, text 20, skills 20, location 15,
# work_model 8, language 7, recency 5), e.g. {"skills": 30, "recency": 10}
BOT_RANK_WEIGHTS=

# --- OpenStreetMap Overpass (be conservative: shared community service) ---------
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_STATUS_URL=https://overpass-api.de/api/status
OVERPASS_MAX_REQUESTS_PER_DAY=50
OVERPASS_MAX_MB_PER_DAY=200
OVERPASS_MIN_INTERVAL_S=30
OVERPASS_CACHE_HOURS=24
OVERPASS_QUERY_TIMEOUT_S=180

# --- website verification ------------------------------------------------------
VERIFY_CONCURRENCY=8
VERIFY_TIMEOUT_S=15
VERIFY_RECHECK_DAYS=30
# Queue newly verified companies for career-page crawling automatically
AUTO_QUEUE_VERIFIED=true

# --- misc ----------------------------------------------------------------------------
IMPORT_MAX_MB=20
LOG_LEVEL=INFO
SESSION_TTL_HOURS=12
COOKIE_SECURE=true

# --- career crawler (initial tuning for 2 vCPU / 4 GB; the resource controller adapts below) ---
CRAWLER_ENABLED=true
CRAWLER_HTTP_CONCURRENCY=16
CRAWLER_PER_DOMAIN_DELAY_S=2
CRAWLER_HTTP_TIMEOUT_S=15
CRAWLER_COMPANIES_IN_PARALLEL=16
CRAWLER_MAX_PAGES_PER_COMPANY=50
CRAWLER_MAX_DEPTH=4
CRAWLER_BROWSER_ENABLED=true
CRAWLER_BROWSER_MEM_PAUSE_MB=600
CRAWLER_BROWSER_MEM_RESUME_MB=900
# Keep raw HTML only for debugging (retention-limited)
CRAWLER_KEEP_RAW_HTML=false
CRAWLER_RAW_HTML_RETENTION_DAYS=7
# Optional LLM fallback via an OpenAI-compatible endpoint (e.g. a local Ollama). Off by default.
CRAWLER_LLM_ENABLED=false
# CRAWLER_LLM_URL=http://ollama:11434/v1/chat/completions
# CRAWLER_LLM_MODEL=qwen2.5:3b-instruct
# --- ATS providers and search-aware crawling (docs/ATS.md) ---
# Only these providers are fetched. smartrecruiters and ashby are implemented from documented
# structures + offline fixtures only; their robots.txt blocked the v3 diagnostics. Do not enable
# them for live crawling until you have permission and have validated them with the probe.
CRAWLER_ATS_ENABLED_PROVIDERS=personio,greenhouse,lever
# A catalogue larger than this is "capped" (the scan is then never complete)
CRAWLER_ATS_CATALOG_MAX_JOBS=2000
# Bounded keyword/location search for providers that have a search API. Off by default.
CRAWLER_ATS_SEARCH_ENABLED=false
CRAWLER_ATS_SEARCH_KEYWORDS=engineer,developer,data,product,devops,security,design,analyst,manager,sales,marketing
CRAWLER_ATS_SEARCH_COUNTRIES=DE,AT,CH
CRAWLER_ATS_SEARCH_MAX_QUERIES=40
CRAWLER_ATS_SEARCH_MAX_PAGES=5
CRAWLER_ATS_SEARCH_MAX_JOBS=5000
# --- Vacancy statistics and Telegram reports (docs/STATS.md) ---
CRAWLER_STATS_TIMEZONE=Europe/Berlin
# Shown in generated posts (optional): https://t.me/<bot_username>
CRAWLER_STATS_TELEGRAM_BOT_LINK=
# Phase 4, publishing to a channel: OFF by default. The token lives only here, never in the UI or the API.
CRAWLER_STATS_TELEGRAM_ENABLED=false
# CRAWLER_STATS_TELEGRAM_BOT_TOKEN=
# CRAWLER_STATS_TELEGRAM_CHAT_ID=@your_channel
CRAWLER_STATS_TELEGRAM_POST_EMPTY=false
# Safe test mode: serve all requests from bundled fixture websites (never touches employer sites)
CRAWLER_TEST_MODE=false
# CRAWLER_FIXTURES_DIR=/app/benchmark/sites
