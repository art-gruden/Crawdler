     },
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string",
         "maxLength": 200
        },
        {
         "type": "null"
        }
       ],
       "description": "Search in name, domain, city",
       "title": "Q"
      },
      "description": "Search in name, domain, city"
     },
     {
      "name": "region",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Kreisschlüssel (e.g. 14612) or ISO 3166-2 state code",
       "title": "Region"
      },
      "description": "Kreisschlüssel (e.g. 14612) or ISO 3166-2 state code"
     },
     {
      "name": "industry",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Industry"
      }
     },
     {
      "name": "verification",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Comma-separated verification statuses",
       "title": "Verification"
      },
      "description": "Comma-separated verification statuses"
     },
     {
      "name": "scan_status",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Scan Status"
      }
     },
     {
      "name": "source",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "osm, csv:standort_sachsen, …; prefix match",
       "title": "Source"
      },
      "description": "osm, csv:standort_sachsen, …; prefix match"
     },
     {
      "name": "job_id",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Only companies touched by this discovery job",
       "title": "Job Id"
      },
      "description": "Only companies touched by this discovery job"
     },
     {
      "name": "new_in_job",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "description": "With job_id: only companies created by that job",
       "default": false,
       "title": "New In Job"
      },
      "description": "With job_id: only companies created by that job"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Page"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
