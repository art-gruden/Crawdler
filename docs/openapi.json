 "components": {
  "schemas": {
   "Body_import_companies_api_companies_import_post": {
    "properties": {
     "file": {
      "type": "string",
      "contentMediaType": "application/octet-stream",
      "title": "File",
      "description": "CSV file, UTF-8 or Windows-1252, delimiter , ; tab or |"
     },
     "profile": {
      "type": "string",
      "title": "Profile",
      "default": "generic"
     },
     "source_name": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 80
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Name",
      "description": "Directory name, e.g. 'IHK Dresden'"
     },
     "license": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 64
       },
       {
        "type": "null"
       }
      ],
      "title": "License"
